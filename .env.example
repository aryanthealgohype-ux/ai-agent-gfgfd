# =============================================================================
# AI Operating System — Agent Fleet Command Center
# Copy this file to `.env`, fill in real values, and NEVER commit `.env`.
#
# Legend:
#   [managed]  Injected automatically by Lovable Cloud — do not set by hand.
#   [required] Needed for the app to boot / core features to work.
#   [optional] Only needed if you enable that agent or connector.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BACKEND / DATABASE (Supabase)  [managed on Lovable Cloud]
# -----------------------------------------------------------------------------
# Browser-visible (safe, publishable):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only (never expose to the browser, never prefix with VITE_):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref
# Direct Postgres connection (migrations / analytics only):
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# 2. APP URLS  [required for OAuth redirects, webhooks and email links]
# -----------------------------------------------------------------------------
# Public site origin, no trailing slash.
VITE_APP_URL=http://localhost:8080
APP_URL=http://localhost:8080
# Where social / OAuth providers send users back:
OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback


# -----------------------------------------------------------------------------
# 3. MODEL PROVIDERS
# -----------------------------------------------------------------------------
# Default path: Lovable AI Gateway. One key covers every chat/vision/embedding
# model the agents use. [managed on Lovable Cloud]
LOVABLE_API_KEY=
LOVABLE_AI_GATEWAY_URL=https://ai.gateway.lovable.dev/v1

# Default models used by the fleet (override per agent in the dashboard).
DEFAULT_AGENT_MODEL=google/gemini-3.6-flash
DEFAULT_REASONING_MODEL=google/gemini-3.1-pro-preview
DEFAULT_EMBEDDING_MODEL=google/text-embedding-004

# Optional direct provider keys — only if you bypass the gateway. [optional]
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=


# -----------------------------------------------------------------------------
# 4. n8n WORKFLOW LAYER  [optional]
# -----------------------------------------------------------------------------
# Base URL of your n8n instance (no trailing slash):
N8N_BASE_URL=https://your-instance.app.n8n.cloud
# Default webhook an agent posts to when no per-agent webhook is set:
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/agent
# Shared HMAC secret — n8n verifies our signature, we verify n8n callbacks:
N8N_WEBHOOK_SECRET=
# n8n public API key (to list/trigger workflows programmatically):
N8N_API_KEY=
# URL n8n calls back when a human approves/denies a gated run:
APPROVAL_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/approval

# ---------- ALERT DELIVERY ----------
# From address used for spend-stop / dead-letter alert emails (must be a verified sending domain).
ALERT_EMAIL_FROM=AI Operating System <alerts@yourdomain.com>
# Slack destinations are stored per workspace in Settings → Alert delivery channels
# (https://hooks.slack.com/services/... incoming webhook), not in this file.



# -----------------------------------------------------------------------------
# 5. MESSAGING / COMMUNICATION CONNECTORS  [optional per agent]
# -----------------------------------------------------------------------------
# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# Slack (bot token, chat:write + channels:history)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Twilio (voice + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email sending (transactional / outreach)
RESEND_API_KEY=
EMAIL_FROM="AI Ops <ops@yourdomain.com>"


# -----------------------------------------------------------------------------
# 6. GOOGLE WORKSPACE (Gmail, Calendar, Sheets, YouTube)  [optional]
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEETS_SPREADSHEET_ID=
YOUTUBE_CHANNEL_ID=


# -----------------------------------------------------------------------------
# 7. SOCIAL MEDIA CONNECTORS (read inputs + publish outputs)  [optional]
# -----------------------------------------------------------------------------
# Meta Graph API — one Page access token covers Facebook + Instagram.
# Scopes: pages_manage_posts, pages_read_engagement, instagram_basic,
#         instagram_content_publish, instagram_manage_comments
META_GRAPH_VERSION=v21.0
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ID=

# X / Twitter — API v2. A user-context OAuth2 token is required to POST;
# an app-only bearer token can read public data only.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# LinkedIn — automation is strictly regulated; approved scopes only.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=


# -----------------------------------------------------------------------------
# 8. DEV / INFRA CONNECTORS  [optional]
# -----------------------------------------------------------------------------
# GitHub fine-grained token: contents:read + pull_requests:write ONLY.
# Never grant admin or workflow scope to an agent.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo


# -----------------------------------------------------------------------------
# 9. VOICE (consent-gated)  [optional]
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=


# -----------------------------------------------------------------------------
# 10. SAFETY / OPERATIONS GUARDRAILS
# -----------------------------------------------------------------------------
# Runs from agents at or above this safety rating always need human approval.
SAFETY_APPROVAL_THRESHOLD=4
# Hard caps enforced by outreach agents:
DAILY_SEND_CAP=30
FOLLOW_UP_CAP=2
# Max USD an org may spend on model calls per day (0 = unlimited):
DAILY_SPEND_CAP_USD=0
