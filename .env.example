# =============================================================
# AI Agent Fleet — Command Center
# Copy to .env and fill in real values. NEVER commit .env.
# Lovable Cloud already injects SUPABASE_* and LOVABLE_API_KEY.
# =============================================================

# --- Core (managed by Lovable Cloud, do not set manually) ---
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=

# --- Communication ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google (Gmail, Calendar, Sheets, YouTube) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Messaging / Social ---
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ID=
LINKEDIN_ACCESS_TOKEN=
X_BEARER_TOKEN=

# --- Dev & Infra ---
# GitHub: repo:read + pull_request:write ONLY. Never admin scope.
GITHUB_TOKEN=

# --- Voice (consent-gated) ---
ELEVENLABS_API_KEY=

# --- Optional: n8n execution layer ---
N8N_WEBHOOK_SECRET=
APPROVAL_WEBHOOK_URL=
